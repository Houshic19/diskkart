<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= p.name %> - DiskKart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark navbar-expand-lg">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/">
      <i class="fas fa-server"></i> DiskKart
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/category/Storage">Storage</a></li>
        <li class="nav-item"><a class="nav-link" href="/category/RAM">RAM</a></li>
        <li class="nav-item"><a class="nav-link" href="/category/Graphics Card">GPU</a></li>
        <li class="nav-item"><a class="nav-link" href="/cart"><i class="fas fa-shopping-cart"></i> Cart</a></li>
        <% if(user) { %>
          <li class="nav-item"><a class="nav-link" href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login"><i class="fas fa-sign-in-alt"></i> Login</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<div class="container py-5">
  <div class="row">
    <div class="col-md-5 mb-4">
      <div class="card shadow-sm">
        <% if(p.image) { %>
          <img src="<%= p.image %>" class="card-img-top" alt="<%= p.name %>" style="height: 400px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/400?text=<%= encodeURIComponent(p.name) %>'">
        <% } else { %>
          <div style="height: 400px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-image" style="font-size: 4rem; color: #ccc;"></i>
          </div>
        <% } %>
      </div>
    </div>
    <div class="col-md-7">
      <div class="card shadow-sm">
        <div class="card-body">
          <span class="badge bg-primary mb-3"><%= p.category %> / <%= p.subcategory %></span>
          <h1 class="card-title mb-4"><%= p.name %></h1>
          
          <p class="lead text-muted mb-4"><%= p.description %></p>
          
          <div class="row align-items-center">
            <div class="col-md-12">
              <h2 class="text-success fw-bold mb-4">₹<%= p.price %></h2>
              <p class="text-muted mb-4">Competitive pricing with best value</p>
              <form action="/add-to-cart" method="POST" class="d-grid gap-2">
                <input type="hidden" name="product_id" value="<%= p.id %>">
                <input type="hidden" name="name" value="<%= p.name %>">
                <input type="hidden" name="price" value="<%= p.price %>">
                <div class="mb-3">
                  <label class="form-label">Quantity:</label>
                  <input type="number" name="qty" class="form-control" value="1" min="1">
                </div>
                <button class="btn btn-lg btn-success" type="submit">
                  <i class="fas fa-shopping-cart"></i> Add to Cart
                </button>
                <a href="/" class="btn btn-lg btn-outline-secondary">
                  <i class="fas fa-home"></i> Continue Shopping
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div class="card shadow-sm mt-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">Product Details</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <p><strong>Category:</strong> <%= p.category %></p>
              <p><strong>Subcategory:</strong> <%= p.subcategory %></p>
            </div>
            <div class="col-md-6">
              <p><strong>Product ID:</strong> <%= p.id %></p>
              <p><strong>Availability:</strong> <span class="badge bg-success">In Stock</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm mb-4">
        <div class="card-body text-center">
          <h5>Secure Checkout</h5>
          <p class="text-muted">Fast & Safe Payment</p>
          <a href="/checkout" class="btn btn-warning btn-lg w-100">
            <i class="fas fa-lock"></i> Checkout
          </a>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">Specifications</h5>
        </div>
        <div class="card-body">
          <p><%- p.description %></p>
          <ul class="list-unstyled">
            <li><i class="fas fa-check text-success"></i> Genuine Product</li>
            <li><i class="fas fa-check text-success"></i> Warranty Included</li>
            <li><i class="fas fa-check text-success"></i> Free Shipping</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<footer class="bg-dark text-white mt-5 py-4">
  <div class="container">
    <p class="mb-0">© 2026 DiskKart. All rights reserved. | support@diskkart.com</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
