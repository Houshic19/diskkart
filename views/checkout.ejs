<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout - DiskKart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark navbar-expand-lg">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/">
      <i class="fas fa-server"></i> DiskKart
    </a>
  </div>
</nav>

<div class="container py-5">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <h1 class="mb-4">
        <i class="fas fa-credit-card"></i> Checkout
      </h1>

      <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="fas fa-user-check"></i> Account Info</h5>
        </div>
        <div class="card-body">
          <p><strong>User:</strong> <%= user.username %></p>
          <small class="text-muted">Not <%= user.username %>? <a href="/logout">Logout</a></small>
        </div>
      </div>

      <form id="checkoutForm">
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-map-marker-alt"></i> Shipping Address</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" name="fullname" required>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email" required>
              </div>
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label">Phone</label>
                <input type="tel" class="form-control" name="phone" required>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label">Postal Code</label>
                <input type="text" class="form-control" name="postalcode" required>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Street Address</label>
              <input type="text" class="form-control" name="address" placeholder="Enter your street address" required>
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label">City</label>
                <input type="text" class="form-control" name="city" required>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label">State</label>
                <input type="text" class="form-control" name="state" required>
              </div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm mb-4">
          <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-box"></i> Order Summary</h5>
          </div>
          <div class="card-body">
            <% if(cart && cart.length > 0) { %>
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Subtotal</th>
                  </tr>
                </thead>
                <tbody>
                  <% cart.forEach(item => { %>
                    <tr>
                      <td><%= item.name %></td>
                      <td><%= item.qty %></td>
                      <td class="text-end">₹<%= item.price %></td>
                      <td class="text-end">₹<%= item.price * item.qty %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
              <hr>
              <div class="row">
                <div class="col-md-6">
                  <p><strong>Subtotal:</strong></p>
                  <p><strong>Shipping:</strong></p>
                  <p><strong>Tax:</strong></p>
                </div>
                <div class="col-md-6 text-end">
                  <p><strong>₹<%= total %></strong></p>
                  <p><strong class="text-success">FREE</strong></p>
                  <p><strong>₹0</strong></p>
                </div>
              </div>
              <hr>
              <div class="row">
                <div class="col-md-6">
                  <h5><strong>Total Amount:</strong></h5>
                </div>
                <div class="col-md-6 text-end">
                  <h5><strong class="text-success">₹<%= total %></strong></h5>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card shadow-sm mb-4">
          <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-credit-card"></i> Payment Method</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Amount to Pay (₹):</label>
              <input type="number" class="form-control form-control-lg" id="amount" name="amount" value="<%= total %>" required>
            </div>

            <div class="mb-3">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="payment" id="razorpay" value="razorpay" checked>
                <label class="form-check-label" for="razorpay">
                  Razorpay Payment Gateway
                </label>
              </div>
            </div>

            <button type="button" onclick="processPayment()" class="btn btn-success btn-lg w-100">
              <i class="fas fa-lock"></i> Proceed to Payment
            </button>
          </div>
        </div>
      </form>

      <div class="alert alert-info" role="alert">
        <strong><i class="fas fa-info-circle"></i> Secure Checkout</strong>
        <p class="mb-0">Your payment information is protected with industry-leading encryption.</p>
      </div>
    </div>
  </div>
</div>

<footer class="bg-dark text-white mt-5 py-4">
  <div class="container">
    <p class="mb-0">© 2026 DiskKart. All rights reserved. | support@diskkart.com</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
function processPayment() {
  const form = document.getElementById('checkoutForm');
  const amount = parseInt(document.getElementById('amount').value);
  
  // For demo: you can modify this to use actual Razorpay integration
  // Create order on backend first
  fetch('/pay', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded'
    },
    body: 'amount=' + amount
  })
  .then(res => res.json())
  .then(data => {
    if(data.id) {
      // Open Razorpay payment modal
      const options = {
        key: '<%= razorpayKey %>',
        amount: amount * 100,
        currency: 'INR',
        order_id: data.id,
        name: 'DiskKart',
        description: 'Computer Hardware Purchase',
        handler: function(response) {
          // Payment successful
          alert('Payment successful! Order ID: ' + response.razorpay_payment_id);
          window.location.href = '/';
        },
        theme: {
          color: '#667eea'
        }
      };
      const rzp = new Razorpay(options);
      rzp.open();
    }
  })
  .catch(err => {
    alert('Payment service error: ' + err.message);
  });
}
</script>
</body>
</html>
