<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - DiskKart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .sidebar {
      background: #2c3e50;
      min-height: 100vh;
      color: white;
      padding: 20px;
    }
    .sidebar h4 {
      margin-bottom: 20px;
      border-bottom: 2px solid #667eea;
      padding-bottom: 10px;
    }
    .sidebar a {
      display: block;
      color: #ecf0f1;
      text-decoration: none;
      padding: 12px 15px;
      margin-bottom: 10px;
      border-radius: 5px;
      transition: all 0.3s;
    }
    .sidebar a:hover {
      background: #667eea;
      color: white;
    }
    .sidebar a.active {
      background: #667eea;
      color: white;
    }
    .stat-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 25px;
      border-radius: 10px;
      margin-bottom: 20px;
      text-align: center;
    }
    .stat-card h5 {
      margin-bottom: 10px;
      opacity: 0.9;
    }
    .stat-card .number {
      font-size: 2.5rem;
      font-weight: bold;
    }
  </style>
</head>
<body>
<div class="container-fluid">
  <div class="row">
    <div class="col-md-3">
      <div class="sidebar">
        <h4><i class="fas fa-cog"></i> Admin Panel</h4>
        <p class="text-muted mb-4">Welcome, <%= user.username %></p>
        <a href="/admin" class="active"><i class="fas fa-chart-line"></i> Dashboard</a>
        <a href="/admin/products"><i class="fas fa-box"></i> Products</a>
        <a href="/"><i class="fas fa-home"></i> Back to Store</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>
    </div>
    
    <div class="col-md-9" style="padding: 30px;">
      <h1 class="mb-4">Dashboard</h1>
      
      <div class="row mb-4">
        <div class="col-md-4">
          <div class="stat-card">
            <h5><i class="fas fa-shopping-cart"></i> Total Orders</h5>
            <div class="number"><%= total_orders %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <h5><i class="fas fa-rupee-sign"></i> Total Revenue</h5>
            <div class="number">₹<%= revenue || 0 %></div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <h5><i class="fas fa-check-circle"></i> Completed</h5>
            <div class="number"><%= orders.filter(o => o.payment_status === 'completed').length %></div>
          </div>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0"><i class="fas fa-list"></i> Recent Orders</h5>
        </div>
        <div class="card-body">
          <% if(orders && orders.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead class="table-dark">
                  <tr>
                    <th>Order ID</th>
                    <th>User</th>
                    <th>Customer Name</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(order => { %>
                    <tr>
                      <td><strong>#<%= order.id %></strong></td>
                      <td><%= order.username %></td>
                      <td><%= order.fullname %></td>
                      <td><strong>₹<%= order.total_amount %></strong></td>
                      <td>
                        <% if(order.payment_status === 'completed') { %>
                          <span class="badge bg-success">Completed</span>
                        <% } else { %>
                          <span class="badge bg-warning">Pending</span>
                        <% } %>
                      </td>
                      <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                      <td>
                        <button class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#orderModal<%= order.id %>">
                          <i class="fas fa-eye"></i>
                        </button>
                      </td>
                    </tr>

                    <!-- Order Details Modal -->
                    <div class="modal fade" id="orderModal<%= order.id %>" tabindex="-1">
                      <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                          <div class="modal-header bg-dark text-white">
                            <h5 class="modal-title">Order #<%= order.id %> Details</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <div class="row mb-3">
                              <div class="col-md-6">
                                <h6>Customer Information</h6>
                                <p><strong>Name:</strong> <%= order.fullname %></p>
                                <p><strong>Email:</strong> <%= order.email %></p>
                                <p><strong>Phone:</strong> <%= order.phone %></p>
                              </div>
                              <div class="col-md-6">
                                <h6>Shipping Address</h6>
                                <p><strong>Address:</strong> <%= order.address %></p>
                                <p><strong>City:</strong> <%= order.city %></p>
                                <p><strong>State:</strong> <%= order.state %></p>
                                <p><strong>Postal Code:</strong> <%= order.postalcode %></p>
                              </div>
                            </div>
                            <hr>
                            <h6>Order Items</h6>
                            <% try { 
                              const items = JSON.parse(order.items);
                              if(items && items.length > 0) { %>
                                <table class="table table-sm">
                                  <thead>
                                    <tr>
                                      <th>Product</th>
                                      <th>Qty</th>
                                      <th>Price</th>
                                      <th>Subtotal</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% items.forEach(item => { %>
                                      <tr>
                                        <td><%= item.name %></td>
                                        <td><%= item.qty %></td>
                                        <td>₹<%= item.price %></td>
                                        <td>₹<%= item.price * item.qty %></td>
                                      </tr>
                                    <% }); %>
                                  </tbody>
                                </table>
                              <% } 
                            } catch(e) { %>
                              <p class="text-muted">Items: <%= order.items %></p>
                            <% } %>
                            <hr>
                            <div class="row">
                              <div class="col-md-6">
                                <h6>Order Total: <strong>₹<%= order.total_amount %></strong></h6>
                              </div>
                              <div class="col-md-6 text-end">
                                <span class="badge bg-<%= order.payment_status === 'completed' ? 'success' : 'warning' %>">
                                  <%= order.payment_status.toUpperCase() %>
                                </span>
                              </div>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-muted text-center py-4">No orders yet</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
