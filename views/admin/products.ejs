<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Products - DiskKart Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .sidebar {
      background: #2c3e50;
      min-height: 100vh;
      color: white;
      padding: 20px;
    }
    .sidebar h4 {
      margin-bottom: 20px;
      border-bottom: 2px solid #667eea;
      padding-bottom: 10px;
    }
    .sidebar a {
      display: block;
      color: #ecf0f1;
      text-decoration: none;
      padding: 12px 15px;
      margin-bottom: 10px;
      border-radius: 5px;
      transition: all 0.3s;
    }
    .sidebar a:hover {
      background: #667eea;
      color: white;
    }
    .sidebar a.active {
      background: #667eea;
      color: white;
    }
  </style>
</head>
<body>
<div class="container-fluid">
  <div class="row">
    <div class="col-md-3">
      <div class="sidebar">
        <h4><i class="fas fa-cog"></i> Admin Panel</h4>
        <p class="text-muted mb-4">Welcome, <%= user.username %></p>
        <a href="/admin"><i class="fas fa-chart-line"></i> Dashboard</a>
        <a href="/admin/products" class="active"><i class="fas fa-box"></i> Products</a>
        <a href="/"><i class="fas fa-home"></i> Back to Store</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>
    </div>
    
    <div class="col-md-9" style="padding: 30px;">
      <h1 class="mb-4">Manage Products</h1>
      
      <div class="row">
        <div class="col-md-6">
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
              <h5 class="mb-0"><i class="fas fa-plus"></i> Add New Product</h5>
            </div>
            <div class="card-body">
              <form action="/admin/add" method="POST">
                <div class="mb-3">
                  <label class="form-label">Product Name</label>
                  <input type="text" class="form-control" name="name" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Category</label>
                  <select class="form-control" name="category" required>
                    <option value="">Select Category</option>
                    <option value="Storage">Storage</option>
                    <option value="RAM">RAM</option>
                    <option value="Graphics Card">Graphics Card</option>
                    <option value="Motherboard">Motherboard</option>
                    <option value="Accessories">Accessories</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label">Subcategory</label>
                  <input type="text" class="form-control" name="subcategory" placeholder="e.g., SSD, GPU" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Description</label>
                  <textarea class="form-control" name="description" rows="3" required></textarea>
                </div>
                <div class="mb-3">
                  <label class="form-label">Price (₹)</label>
                  <input type="number" class="form-control" name="price" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Image URL</label>
                  <input type="text" class="form-control" name="image" placeholder="https://...">
                </div>
                <button type="submit" class="btn btn-primary w-100">
                  <i class="fas fa-plus"></i> Add Product
                </button>
              </form>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
              <h5 class="mb-0"><i class="fas fa-info-circle"></i> Quick Stats</h5>
            </div>
            <div class="card-body">
              <p><strong>Total Products:</strong> <%= p.length %></p>
              <div class="progress mb-3">
                <div class="progress-bar" style="width: <%= Math.min(p.length * 5, 100) %>%"></div>
              </div>
              <p class="text-muted small">Add products to manage your inventory</p>
            </div>
          </div>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0"><i class="fas fa-list"></i> All Products</h5>
        </div>
        <div class="card-body">
          <% if(p && p.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead class="table-dark">
                  <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% p.forEach(product => { %>
                    <tr>
                      <td><strong>#<%= product.id %></strong></td>
                      <td>
                        <div><strong><%= product.name %></strong></div>
                        <small class="text-muted"><%= product.description.substring(0, 50) %>...</small>
                      </td>
                      <td><span class="badge bg-info"><%= product.category %></span></td>
                      <td><strong>₹<%= product.price %></strong></td>
                      <td>
                        <form action="/admin/delete-product" method="POST" style="display:inline;">
                          <input type="hidden" name="product_id" value="<%= product.id %>">
                          <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this product?')">
                            <i class="fas fa-trash"></i> Delete
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-muted text-center py-4">No products added yet</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
